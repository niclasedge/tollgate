diff --git a/internal/svc/save.go b/internal/svc/save.go
new file mode 100644
index 0000000..5d6e7f8
--- /dev/null
+++ b/internal/svc/save.go
@@ -0,0 +1,67 @@
+package svc
+
+import (
+	"context"
+	"fmt"
+)
+
+func Save0(ctx context.Context, in Input) (Output, error) {
+	if in.ID == "" {
+		return Output{}, ErrEmptyID
+	}
+	res, err := store.Load(ctx, in.ID)
+	if err != nil {
+		return Output{}, fmt.Errorf("load %s: %w", in.ID, err)
+	}
+	out := Output{Name: res.Name, Count: len(res.Items)}
+	for _, it := range res.Items {
+		out.Total += it.Size
+	}
+	return out, nil
+}
+
+func Save1(ctx context.Context, in Input) (Output, error) {
+	if in.ID == "" {
+		return Output{}, ErrEmptyID
+	}
+	res, err := store.Load(ctx, in.ID)
+	if err != nil {
+		return Output{}, fmt.Errorf("load %s: %w", in.ID, err)
+	}
+	out := Output{Name: res.Name, Count: len(res.Items)}
+	for _, it := range res.Items {
+		out.Total += it.Size
+	}
+	return out, nil
+}
+
+func Save2(ctx context.Context, in Input) (Output, error) {
+	if in.ID == "" {
+		return Output{}, ErrEmptyID
+	}
+	res, err := store.Load(ctx, in.ID)
+	if err != nil {
+		return Output{}, fmt.Errorf("load %s: %w", in.ID, err)
+	}
+	out := Output{Name: res.Name, Count: len(res.Items)}
+	for _, it := range res.Items {
+		out.Total += it.Size
+	}
+	return out, nil
+}
+
+func Save3(ctx context.Context, in Input) (Output, error) {
+	if in.ID == "" {
+		return Output{}, ErrEmptyID
+	}
+	res, err := store.Load(ctx, in.ID)
+	if err != nil {
+		return Output{}, fmt.Errorf("load %s: %w", in.ID, err)
+	}
+	out := Output{Name: res.Name, Count: len(res.Items)}
+	for _, it := range res.Items {
+		out.Total += it.Size
+	}
+	return out, nil
+}
+
