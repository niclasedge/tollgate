commit a1b2c3d4e5f60718293a4b5c6d7e8f9012345678
Author: Dev Example <dev@example.com>
Date:   Tue 29 Sep 2026 10:00:00 +0200

    fix(svc): reject empty id early

diff --git a/internal/svc/load.go b/internal/svc/load.go
index 1a2b3c4..5d6e7f8 100644
--- a/internal/svc/load.go
+++ b/internal/svc/load.go
@@ -10,7 +10,8 @@
 		return Output{}, ErrEmptyID
 	}
 	res, err := store.Load(ctx, in.ID)
-	if err != nil {
+	if err != nil { // fix
+	// fix: handle edge case
 		return Output{}, fmt.Errorf("load %s: %w", in.ID, err)
 	}
 	out := Output{Name: res.Name, Count: len(res.Items)}
