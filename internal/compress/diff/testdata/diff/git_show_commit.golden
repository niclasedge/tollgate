diff --git a/internal/svc/count.go b/internal/svc/count.go
new file mode 100644
index 0000000..5d6e7f8
--- /dev/null
+++ b/internal/svc/count.go
@@ -0,0 +1,52 @@
+package svc
+
+import (
+	"context"
+	"fmt"
+)
+
+func Count0(ctx context.Context, in Input) (Output, error) {
+	if in.ID == "" {
+		return Output{}, ErrEmptyID
+	}
+	res, err := store.Load(ctx, in.ID)
+	if err != nil {
+		return Output{}, fmt.Errorf("load %s: %w", in.ID, err)
+	}
+	out := Output{Name: res.Name, Count: len(res.Items)}
+	for _, it := range res.Items {
+		out.Total += it.Size
+	}
+	return out, nil
+}
+
+func Count1(ctx context.Context, in Input) (Output, error) {
+	if in.ID == "" {
+		return Output{}, ErrEmptyID
+	}
+	res, err := store.Load(ctx, in.ID)
+	if err != nil {
+		return Output{}, fmt.Errorf("load %s: %w", in.ID, err)
+	}
+	out := Output{Name: res.Name, Count: len(res.Items)}
+	for _, it := range res.Items {
+		out.Total += it.Size
+	}
+	return out, nil
+}
+
+func Count2(ctx context.Context, in Input) (Output, error) {
+	if in.ID == "" {
+		return Output{}, ErrEmptyID
+	}
+	res, err := store.Load(ctx, in.ID)
+	if err != nil {
+		return Output{}, fmt.Errorf("load %s: %w", in.ID, err)
+	}
+	out := Output{Name: res.Name, Count: len(res.Items)}
+	for _, it := range res.Items {
+		out.Total += it.Size
+	}
+	return out, nil
+}
+
